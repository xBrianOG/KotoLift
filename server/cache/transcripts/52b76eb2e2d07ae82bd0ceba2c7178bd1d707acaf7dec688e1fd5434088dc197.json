      "text": "少しの"
    },
    {
      "id": "seg-111",
      "startMs": 337120,
      "endMs": 339120,
      "text": "私たちの"
    },
    {
      "id": "seg-112",
      "startMs": 339120,
      "endMs": 341120,
      "text": "私たちの"
    },
    {
      "id": "seg-113",

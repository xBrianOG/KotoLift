{
  "title": "Generate Flashcards in NotebookLM (NotebookLM)",
  "segments": [
    {
      "id": "seg-1",
      "startMs": 0,
      "endMs": 11000,
      "text": "こんにちは、今からノートブックLMでフラッシュカードを生成する方法をご紹介します。"
    },
    {
      "id": "seg-2",
      "startMs": 11000,
      "endMs": 16000,
      "text": "ノートブックLMのファイルをオープンします。"
    },
    {
      "id": "seg-3",
      "startMs": 16000,
      "endMs": 21000,
      "text": "右側にあるスタジオセクションをご覧ください。"
    },
    {
      "id": "seg-4",
      "startMs": 21000,
      "endMs": 28000,
      "text": "オーナーや編集者がいる場合、それらのオプションをご覧ください。"
    },
    {
      "id": "seg-5",
      "startMs": 28000,
      "endMs": 31000,
      "text": "一つはフラッシュカードのオプションです。"
    },
    {
      "id": "seg-6",
      "startMs": 31000,
      "endMs": 40000,
      "text": "それをクリックすると、ノートブックLMでフラッシュカードを生成することができます。"
    },
    {
      "id": "seg-7",
      "startMs": 40000,
      "endMs": 45000,
      "text": "そして、設定をカスタマイズするためのペンシルアイコンをクリックすることができます。"
    },
    {
      "id": "seg-8",
      "startMs": 45000,
      "endMs": 52000,
      "text": "多くのフューバーカードや難易度のレベルなど。"
    },
    {
      "id": "seg-9",
      "startMs": 52000,
      "endMs": 61000,
      "text": "そして、フラッシュカードを生成するためにその設定を適切に使用するボタンをクリックすることができます。"
    },
    {
      "id": "seg-10",
      "startMs": 61000,
      "endMs": 67000,
      "text": "これはノートブックLMのファイルに関するフラッシュカードの例です。"
    },
    {
      "id": "seg-11",
      "startMs": 67000,
      "endMs": 77000,
      "text": "次のボタンや先ほどのボタンをクリックすることができます。"
    },
    {
      "id": "seg-12",
      "startMs": 77000,
      "endMs": 84000,
      "text": "そして、その答えを見ることができます。"
    },
    {
      "id": "seg-13",
      "startMs": 84000,
      "endMs": 88000,
      "text": "そして、フラッシュカードを説明するための説明ボタンをクリックすることができます。"
    },
    {
      "id": "seg-14",
      "startMs": 88000,
      "endMs": 98000,
      "text": "そして、チャットに出てくると。"
    },
    {
      "id": "seg-15",
      "startMs": 98000,
      "endMs": 100000,
      "text": "ありがとうございました。"
    }
  ],
  "languageDetected": "japanese"
}
{
  "functions": {
    "api/auth.ts": {
      "maxDuration": 30
    },
    "api/video/analyze.ts": {
      "maxDuration": 60
    },
    "api/video/translate.ts": {
      "maxDuration": 30
    },
    "api/explain/index.ts": {
      "maxDuration": 60
    },
    "api/usage/me.ts": {
      "maxDuration": 10
    },
    "api/health.ts": {
      "maxDuration": 5
    }
  },
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": "/api/auth.ts" },
    { "source": "/api/video/(.*)", "destination": "/api/video/$1.ts" }
  ]
}

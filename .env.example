# Frontend Configuration
# Optional: Set this to your deployed API endpoint
# If not set, it will use /api/explain (relative path for Vercel deployment)
VITE_EXPLAIN_API_URL=

# Backend Configuration (for local development or deployment)
# Get your API key from: https://platform.openai.com/settings (API keys)
OPENAI_API_KEY=your_openai_api_key_here

